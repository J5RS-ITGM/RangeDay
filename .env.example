# Copy to .env on the server (~/rangeday/.env) and fill in. Never commit .env.
# Generate strong values:  openssl rand -base64 32
DB_PASSWORD=CHANGE-ME
SECRET_KEY=CHANGE-ME
# open = anyone can sign up; closed = invite-only via the Admin panel.
SIGNUP_MODE=open
# required = signup and SMS reset need a code texted via Twilio Verify.
# Without Twilio creds, codes appear in `docker logs rangeday-api` (testing).
PHONE_VERIFICATION=off
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_VERIFY_SID=
# A Twilio number (+1...) or Messaging Service SID (MG...) for texted invites.
#TWILIO_SMS_FROM=
# Optional SMTP for password-reset emails. Leave unset while testing:
# reset links then appear in `docker logs rangeday-api`.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=
