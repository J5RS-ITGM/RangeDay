{
  "expo": {
    "name": "Range Day",
    "slug": "rangeday",
    "version": "0.2.0",
    "scheme": "rangeday",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#101214",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Range Day uses your photos so you can attach images to community posts."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}